{
  "expo": {
    "name": "Barbosachat",
    "slug": "barbosachat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "backgroundColor": "#0B6B4B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6B4B"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O Barbosachat precisa de acesso às fotografias para as partilhares nas tuas conversas.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-dev-client"
    ],
    "scheme": "barbosachat",
    "extra": {
      "eas": {
        "projectId": "fa03a43f-516b-4704-ab86-d0f11866118f"
      }
    }
  }
}
